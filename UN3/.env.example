# 이 파일을 복사해서 .env로 만들고 실제 값을 채워넣으세요
# cp .env.example .env

OPENAI_API_KEY=

# comtradeplus.un.org 에서 무료로 가입하면 자동 승인됩니다 (비용 없음).
# 가입 후 comtradedeveloper.un.org 에서 "comtrade - v1" 구독을 선택하면
# API 키가 발급됩니다.
UN_COMTRADE_SUBSCRIPTION_KEY=

# --- 아래는 선택 기능입니다 (없어도 위 UN Comtrade 조사는 정상 동작합니다) ---
# 한국 관세청이 "직접 신고받은" 수출입 통계를 UN Comtrade 수치 옆에 나란히
# 보여줍니다 (두 수치가 다를 수 있다는 걸 직접 확인하기 위한 교차검증용).
#
# 1) data.go.kr 에서 아래 두 데이터셋을 각각 "활용신청"하세요 (보통 자동/빠르게 승인됨):
#    - 관세청_품목별 수출입실적(GW)
#    - 관세청_품목별 국가별 수출입실적(GW)
# 2) 승인 화면에 나오는 인증키(보통 계정당 1개, 데이터셋 공용)를 아래에 넣으세요.
DATA_GO_KR_API_KEY=

# 3) 각 데이터셋의 "활용신청 상세" 화면에 있는 "요청 URL(Endpoint)"을 그대로
#    복사해서 붙여넣으세요. (이 URL은 데이터셋마다 다르고 자동으로 채워드릴 수
#    없어서 비워뒀습니다 - customs_cli.py --debug로 먼저 확인해보세요.)
CUSTOMS_ITEM_API_URL=
CUSTOMS_ITEM_COUNTRY_API_URL=
